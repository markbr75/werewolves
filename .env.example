# Copy this file to .env and fill in the three values from your LiveKit Cloud project
# (Settings > Keys). Without them the game still runs, but with no video.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Optional but recommended once the game is online: a secret word needed to START a village.
# Players joining with a village code do not need it.
HOST_PASSCODE=
PORT=3000
